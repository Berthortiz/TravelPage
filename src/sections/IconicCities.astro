---
import Img1 from "../assets/sec-2-img1.png";
import ButtonWhatsapp from "../components/ButtonWhatsapp.astro";
import IconPhone from "../assets/icons/iconPhone.svg";
---

<section
    class="lg:max-w-7xl mx-auto px-5 py-20 flex flex-col gap-10 lg:flex-row-reverse"
>
    <div class="[&_p]:text-[1.2em] text-center lg:w-1/2 lg:text-left">
        <h2
            class="text-[2.5em] font-bold font-protest-strike leading-12 tracking-[.04em] uppercase pb-4 lg:text-6xl lg:leading-16"
        >
            Te llevamos a las Pricipales
            <span class="text-[var(--color-primary)] font-protest-strike">
                ciudades icónicas de japón</span
            >
        </h2>
        <p class="text-[var(--color-paragraph)] pb-3">
            Descubre las ciudades más emblemáticas de Japón: Tokio, moderna y
            vibrante; Kioto, cuna de templos y tradición; Osaka, capital
            gastronómica y cultural; Hiroshima, símbolo de paz y resiliencia; y
            Sapporo, ideal para explorar paisajes del norte.
        </p>
        <p class="text-[var(--color-paragraph)] pb-6">
            Cada destino ofrece experiencias únicas para todo tipo de viajero.
        </p>
        <div class="flex">
            <ButtonWhatsapp
                label="Reserva Ahora"
                href="https://web.whatsapp.com/"
            />
            <a
                class="buttonReserve px-6 py-3 rounded-4xl flex items-center gap-2 text-[var(--color-primary)] font-semibold"
                href="tel:+14076018961"
                target="_blank"
                rel="noopener noreferrer"
                title="Llámanos y Reserva un viaje Ahora"
                aria-label="Abrir ejemplo.com en una nueva pestaña"
            >
                <IconPhone /> +1 (407) 601-8961
            </a>
        </div>
    </div>
    <div
        class="flex gap-3.5 [&_img]:border-12 [&_img]:object-cover [&_img]:rounded-2xl [&_img]:border-[var(--color-primary)] lg:w-1/2 lg:flex-row-reverse lg:gap-5"
    >
        <div class="w-[55%] flex items-center">
            <img
                class="lg:h-[85%]"
                src="/sec-2-img3.png"
                alt="Foto de Osaka, japon."
            />
        </div>
        <div class="iconsCitys w-[45%] flex flex-col gap-4 lg:gap-5">
            <img class="h-1/2" src={Img1.src} alt="foto de Kioto, Japón." />
            <img
                class="h-1/2"
                src="/sec-2-img2.png"
                alt="Foto de Tokyo, japon."
            />
        </div>
    </div>
</section>
<style></style>
