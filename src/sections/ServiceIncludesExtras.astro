---
import { Icon } from "astro-icon/components";
import ButtonWhatsapp from "../components/ButtonWhatsapp.astro";

// src/pages/servicios.astro
const services = [
    {
        icon: "search-icon-travel",
        title: "Asesoría Personalizada",
        description:
            "Rolestiae non recusandae itaque earum rerum hic tenetur a sapiente delectus aut reiciendis",
    },
    {
        icon: "icon-auto-travel",
        title: " Itinerarios a medida",
        description:
            "Rolestiae non recusandae itaque earum rerum hic tenetur a sapiente delectus aut reiciendis",
    },
    {
        icon: "icon-tours-travel",
        title: "Tour Grupales",
        description:
            "Rolestiae non recusandae itaque earum rerum hic tenetur a sapiente delectus aut reiciendis",
    },
];
---

<section class="relative overflow-hidden lg:py-24">
    <div
        class="stardust absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 rotate-[-7deg] z-0 scale-x-[2.5] scale-y-[4.2] rounded-full mask-radial-gradient h-56 md:h-80 lg:h-96 w-full pointer-events-none opacity-80"
    >
    </div>

    <h2
        class="text-[2.5rem] text-center font-bold font-protest-strike leading-12 tracking-[.04em] uppercase pb-4 lg:text-6xl lg:leading-12"
    >
        Deja todo en nuestras manos <br />
        <span
            class="text-[var(--color-primary)] text-[2.3rem] font-protest-strike"
        >
            Organizamos Todo para tu viaje a Japón</span
        >
        <br />
        <span class="text-[2.2rem] font-protest-strike">
            Nuestro servicio ofrece
        </span>
    </h2>
    <div
        class="grid grid-cols-1 md:grid-cols-3 gap-6 px-6 lg:max-w-7xl mx-auto relative z-10"
    >
        {
            services.map((service) => (
                <div class="px-8 py-10 md:px-10 md:py-14 rounded-lg border border-orange-500/20 backdrop-blur-3xl flex flex-col items-center text-center gap-4 hover:border-orange-500/40 transition-all duration-300 group bg-[#FFF9F6]">
                    <span class="text-6xl mb-2 group-hover:scale-110 transition-transform duration-300">
                        <Icon
                            name={
                                service.icon === "" ? "star" : `${service.icon}`
                            }
                            size={88}
                            class="text-(--color-brand-secundary) w-full h-auto"
                        />
                    </span>
                    <h3 class="text-xl font-semibold font-protest-strike uppercase">
                        {service.title}
                    </h3>
                    <p class="text-[#646464] text-[15px] leading-relaxed">
                        {service.description}
                    </p>
                    <ButtonWhatsapp
                        label="Contactar"
                        href="https://wa.link/bqgy6d"
                    >
                        <Icon
                            name="whatsapp-solid"
                            slot="before-icon"
                            size={20}
                            class=""
                        />
                    </ButtonWhatsapp>
                </div>
            ))
        }
    </div>
</section>

<style>
    .mask-radial-gradient {
        -webkit-mask-image: radial-gradient(
            rgba(0, 0, 0, 0.8) 0%,
            rgba(0, 0, 0, 0.79) 5.64%,
            rgba(0, 0, 0, 0.761) 10.6%,
            rgba(0, 0, 0, 0.717) 14.9%,
            rgba(0, 0, 0, 0.66) 18.7%,
            rgba(0, 0, 0, 0.593) 22.2%,
            rgba(0, 0, 0, 0.518) 25.4%,
            rgba(0, 0, 0, 0.44) 28.5%,
            rgba(0, 0, 0, 0.36) 31.5%,
            rgba(0, 0, 0, 0.282) 34.6%,
            rgba(0, 0, 0, 0.207) 37.8%,
            rgba(0, 0, 0, 0.14) 41.3%,
            rgba(0, 0, 0, 0.083) 45.1%,
            rgba(0, 0, 0, 0.039) 49.4%,
            rgba(0, 0, 0, 0.01) 54.36%,
            rgba(0, 0, 0, 0) 60%
        );
        mask-image: radial-gradient(
            rgba(0, 0, 0, 0.8) 0%,
            rgba(0, 0, 0, 0.79) 5.64%,
            rgba(0, 0, 0, 0.761) 10.6%,
            rgba(0, 0, 0, 0.717) 14.9%,
            rgba(0, 0, 0, 0.66) 18.7%,
            rgba(0, 0, 0, 0.593) 22.2%,
            rgba(0, 0, 0, 0.518) 25.4%,
            rgba(0, 0, 0, 0.44) 28.5%,
            rgba(0, 0, 0, 0.36) 31.5%,
            rgba(0, 0, 0, 0.282) 34.6%,
            rgba(0, 0, 0, 0.207) 37.8%,
            rgba(0, 0, 0, 0.14) 41.3%,
            rgba(0, 0, 0, 0.083) 45.1%,
            rgba(0, 0, 0, 0.039) 49.4%,
            rgba(0, 0, 0, 0.01) 54.36%,
            rgba(0, 0, 0, 0) 60%
        );
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
    }

