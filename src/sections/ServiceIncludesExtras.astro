        background: radial-gradient(
            circle at center,
            rgba(59, 130, 246, 0.6) 0%,
            rgba(37, 99, 235, 0.3) 30%,
            rgba(29, 78, 216, 0.1) 60%,
            transparent 100%
        );
        filter: blur(20px);
    } */
</style>
