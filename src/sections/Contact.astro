---
import { Icon } from "astro-icon/components";
import ButtonWhatsapp from "../components/ButtonWhatsapp.astro";

Icon;
---

<section
    class="lg:max-w-7xl mx-auto px-5 py-20 flex flex-col gap-10 text-white"
>
    <div
        class="contact-item text-center flex flex-col items-center px-12 py-15 gap-8 md:items-start"
    >
        <h2 class="font-protest-strike text-6xl">Contacto</h2>
        <div id="" class="[&_p]:text-[1.6em] flex flex-col gap-8 md:flex-row">
            <div class="">
                <p class="font-bold md:text-start">Teléfono:</p>
                <div class="flex justify-center md:justify-start">
                    <Icon name="icon-phone" size={30} />
                    <address class="pt-1">+1 (407) 601-8961</address>
                </div>
            </div>
            <div class="">
                <p class="font-bold">Redes Sociales</p>
                <div class="flex justify-center gap-3 pt-2 md:justify-start">
                    <Icon name="icon-instagram" size={30} />
                    <Icon name="icon-youtube" size={31} />
                </div>
            </div>
        </div>
        <p class="text-contact max-w-[62ch] md:text-start">
            Escríbenos directamente a whatsapp y recibe atención personalizada,
            recomendaciones exclusivas y opciones flexibles según tu
            presupuesto.
        </p>
        <ButtonWhatsapp label="Mensaje via whatsapp" href="#" />
    </div>
</section>

<style>
    .contact-item {
        border: 7px solid var(--color-primary);
        border-radius: 20px;
        background-image:
            linear-gradient(140deg, rgba(0, 0, 0, 0.841) 50%, transparent 100%),
            url("/monte-fuji.jpg");
        background-size: cover;
        background-position: center;
    }
    .text-contact {
        text-shadow: 4px 2px 2px rgb(23, 23, 23);
    }
</style>
