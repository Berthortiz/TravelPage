---
interface Props {
    label: string;
    class?: string;
    // icon?: any;
}

const { label, class: className = "" } = Astro.props;
import IconAir from "../assets/icons/icon-air.svg";
---

<a
    class:list={[
        "buttonReserve px-6 py-3 rounded-4xl flex items-center gap-2 font-bold",
        className,
    ]}
    href="https://wa.link/bqgy6d"
>
    <IconAir />
    <span>{label}</span>
</a>

<style>
    .buttonReserve {
        background: var(--gradient-primary);
        /* background: linear-gradient(to left, red, green); */
    }
</style>
