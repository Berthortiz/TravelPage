---
interface Props {
    label: string;
    // icon?: any;
}

const { label } = Astro.props;
import IconAir from "../assets/icons/icon-air.svg";
---

<a
    class="buttonReserve px-6 py-3 rounded-4xl flex items-center gap-2 font-bold"
    href="#"
>
    <IconAir />
    <span>{label}</span>
</a>

<style>
    .buttonReserve {
        background: var(--gradient-primary);
        /* background: linear-gradient(to left, red, green); */
    }
</style>
