---
import { Icon } from "astro-icon/components";

const links = [
    { href: "/", label: "Inicio" },
    { href: "/#seccionIconicCities", label: "Destinos" },
    { href: "/#ServiceIncludes", label: "Servicios" },
    { href: "/#gallery-swiper", label: "Reseñas" },
];

const socialLinks = [
    {
        href: "https://www.instagram.com/berth_ortiz/",
        label: "Instagram de Berth Ortiz",
        icon: "icon-instagram",
    },
    {
        href: "https://youtube.com/@berthortiz?si=BBZQJ3pbdA6iKWga",
        label: "YouTube de Berth Ortiz",
        icon: "icon-youtube",
    },
];
---

<footer class="travel-footer">
    <div class="footer-inner">
        <div class="footer-main">
            <div class="footer-brand">
                <a href="/" aria-label="Berth Ortiz, inicio">
                    <img
                        src="/logo-1.svg"
                        alt="Berth Ortiz Travel"
                        width="55"
                        height="49"
                        loading="lazy"
                    />
                </a>
                <p>
                    Planeamos tu viaje a Japón para que disfrutes cada destino
                    con tranquilidad.
                </p>
            </div>

            <nav class="footer-nav" aria-label="Navegación del pie de página">
                <h2>Explora</h2>
                {links.map((link) => <a href={link.href}>{link.label}</a>)}
            </nav>

            <div class="footer-contact">
                <h2>Hablemos de tu viaje</h2>
                <a
                    class="footer-contact-link"
                    href="https://wa.link/bqgy6d"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <Icon name="whatsapp-solid" size={20} />
                    Escríbenos por WhatsApp
                </a>
                <a class="footer-contact-link" href="tel:+14076018961">
                    <Icon name="icon-phone" size={20} />
                    +1 (407) 601-8961
                </a>
                <div class="footer-socials" aria-label="Redes sociales">
                    {
                        socialLinks.map((social) => (
                            <a
                                href={social.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={social.label}
                                title={social.label}
                            >
                                <Icon name={social.icon} size={20} />
                            </a>
                        ))
                    }
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <small>
                © {new Date().getFullYear()} Berth Ortiz. Todos los derechos reservados.
            </small>
            <a href="/">Viajes a Japón</a>
        </div>
    </div>
</footer>

<style>
    .travel-footer {
        border-top: 4px solid var(--color-primary, #ff6524);
        background: #171a1c;
        color: #f7f7f7;
    }

    .footer-inner {
        width: min(100% - 3rem, 80rem);
        margin-inline: auto;
    }

    .footer-main {
        display: grid;
        grid-template-columns: 1.3fr 0.7fr 1fr;
        gap: 3rem;
        padding-block: 3.5rem;
    }

    .footer-brand img {
        display: block;
        width: 55px;
        height: 49px;
    }

    .footer-brand p {
        max-width: 28rem;
        margin: 1rem 0 0;
        color: #c1c5c7;
        line-height: 1.7;
    }

    .footer-nav,
    .footer-contact {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.85rem;
    }

    .footer-nav h2,
    .footer-contact h2 {
        margin: 0 0 0.4rem;
        color: #fff;
        font-size: 1rem;
        font-weight: 700;
    }

    .footer-nav a,
    .footer-contact-link,
    .footer-bottom a {
        color: #c1c5c7;
        text-decoration: none;
        transition: color 180ms ease;
    }

    .footer-nav a:hover,
    .footer-nav a:focus-visible,
    .footer-contact-link:hover,
    .footer-contact-link:focus-visible,
    .footer-bottom a:hover,
    .footer-bottom a:focus-visible {
        color: var(--color-primary, #ff6524);
    }

    .footer-contact-link {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
    }

    .footer-socials {
        display: flex;
        gap: 0.65rem;
        margin-top: 0.35rem;
    }

    .footer-socials a {
        display: grid;
        width: 2.5rem;
        height: 2.5rem;
        place-items: center;
        border: 1px solid #565b5d;
        border-radius: 50%;
        color: #fff;
        transition:
            color 180ms ease,
            border-color 180ms ease;
    }

    .footer-socials a:hover,
    .footer-socials a:focus-visible {
        border-color: var(--color-primary, #ff6524);
        color: var(--color-primary, #ff6524);
    }

    .footer-bottom {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        border-top: 1px solid #34393b;
        padding-block: 1.25rem;
        color: #aeb3b5;
    }

    .footer-bottom small {
        font-size: 0.8rem;
    }

    @media (max-width: 700px) {
        .footer-main {
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            padding-block: 2.5rem;
        }

        .footer-brand {
            grid-column: 1 / -1;
        }
    }

    @media (max-width: 420px) {
        .footer-inner {
            width: min(100% - 2rem, 80rem);
        }

        .footer-main {
            grid-template-columns: 1fr;
        }

        .footer-brand {
            grid-column: auto;
        }

        .footer-bottom {
            flex-direction: column;
        }
    }
</style>
