---
import ButtonPrimary from "./ButtonPrimary.astro";

const cities = [
    {
        label: "Osaka",
        imgCity: "/pexels-apasaric-1510595.jpg",
    },
    {
        label: "Kioto",
        imgCity: "/kio-japon.jpg",
    },
    {
        label: "Tokyo",
        imgCity: "/h2-japn.jpg",
    },
];
---

<div id="iconic-pictures" class="absolute inset-0 z-50">
    {
        cities?.map((city) => (
            <div
                id="container-img"
                class="visible opacity-0 flex justify-center items-center w-full h-full absolute inset-0"
                data-animate="2"
            >
                <img
                    class="absolute inset-0 object-cover object-bottom"
                    src={city.imgCity}
                    alt={city.label}
                />
                <div class="labelCitis opacity-0 invisible blur-box z-100 flex-col items-center justify-center absolute md:py-10 md:px-18 p-10 [&_p]:text-[1.2em] text-center lg:text-left">
                    <p class="text-5xl w-fit">Japón</p>
                    <h5
                        data-labelCitisItem="true"
                        class="dela-gothic-one-regular w-fit text-[2.5em] text-center font-bold leading-12 tracking-[.04em] uppercase pb-4 lg:text-6xl lg:leading-16"
                    >
                        {city.label}
                    </h5>

                    <ButtonPrimary
                        title="Reservar"
                        link="https://wa.link/bqgy6d"
                        additionalClass="hidden md:block [text-shadow:none] mx-auto border border-white/20 hover:border-white/40 text-white  font-light font-l py-1 px-4 rounded-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-white/30"
                    />
                </div>
            </div>
        ))
    }
</div>
<style>
    #iconic-pictures {
        pointer-events: none;
    }

    #iconic-pictures img {
        width: 100%;
        height: 100%;
    }
    [data-animate="1.5"] {
        /* text-shadow: 4px 4px 0px transparent; */
        /* text-shadow:
            4px 4px 0px #000000,
            0 0 10px #ff400083,
            0 0 20px #ff370050; */
    }
    .col-2 {
        /* background-color: rgba(250, 250, 250, 0);
        backdrop-filter: blur(5px) saturate(1);
        border-radius: 20px;
        border: 2px solid rgba(255, 255, 255, 0.253); */
        /* box-shadow: 4px 4px 20px 10px #ffffff4e; */
    }

    .labelCitis p {
        margin: -10px -50px 0 0;
        text-shadow: 1px 1px 2px #000000;
    }
    .labelCitis {
        /* transform: translateY(100%); */
        color: #fff;
        pointer-events: auto;

        text-shadow:
            /* 4px 4px 0px #fff, */
            4px 4px 0px black,
            4px 4px 10px #ffffffc0;
        text-shadow:;
        /* text-shadow:
            4px 4px 0px #000000,
            0 0 10px #ff400083,
            0 0 20px #ff370050; */
    }

    .blur-box {
        background-color: rgba(250, 250, 250, 0);
        backdrop-filter: blur(6px) saturate(1.2);
        border-radius: 20px;
        border: 2px solid rgba(255, 255, 255, 0.253);
    }
</style>
<script>
    import { gsap } from "gsap";
    import { Flip } from "gsap/Flip";

    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);
    gsap.registerPlugin(Flip);

    function animateIconicCities() {
        const media = gsap.matchMedia();
        media.add(
            {
                isMobile: "(max-width: 1023px)",
                isDesktop: "(min-width: 1024px)",
            },
            ({ conditions }) => {
                const isMobile = conditions?.isMobile === true;

                if (isMobile) {
                    gsap.set('[data-animate="1.6"]', { autoAlpha: 1 });
                }

                const tl = gsap.timeline({
                    ease: "power1.out",
                    scrollTrigger: {
                        trigger: "#seccionIconicCities",
                        markers: true,
                        scrub: true,
                        pin: true,
                        start: "top top",
                        end: () =>
                            isMobile
                                ? `+=${Math.round(window.innerHeight * 3)}`
                                : "+=4500",
                    },
                });

                tl.to({}, { duration: 1.5 })
                    .to('[data-animate="1"]', { opacity: 0, duration: 0.5 })
                    .to({}, { duration: 1.5 })

                    .to('[data-animate="1.5"]', { y: 100, delay: 0.3 }, "<");

                if (!isMobile) {
                    tl.to(
                        "[data-animate='1.6']",
                        {
                            autoAlpha: 0,
                            delay: 0.3,
                        },
                        "-=0.3",
                    );
                }

                tl.to('[data-animate="1.5"]', {
                    autoAlpha: 0,
                    duration: 0.5,
                });

                const cityCards =
                    gsap.utils.toArray<HTMLElement>('[data-animate="2"]');
                const setHeaderIconicState = (active: boolean) => {
                    document
                        .querySelector("#header-travel")
                        ?.classList.toggle("is-iconic-cities-active", active);
                };

                cityCards.forEach((card, index) => {
                    const img = card.querySelector("img");
                    const label = card.querySelector(".labelCitis");
                    if (index === 0) {
                        tl.set(".text-nav-custom", { color: "#ffffff" });
                    }
                    const cardStart = tl.duration();
                    // if (index === cityCards.length - 1) {
                    //     tl.to(img, {
                    //         autoAlpha: 0,
                    //     });
                    // }
                    tl.to(card, { autoAlpha: 1, duration: 1 })
                        .to(
                            "#header-travel",
                            {
                                backgroundColor: "transparent",
                                duration: 0.4,
                                onStart: () => setHeaderIconicState(false),
                                onReverseComplete: () =>
                                    setHeaderIconicState(true),
                            },
                            "<",
                        )
                        .to(label, {
                            // dalay: 0.5,
                            autoAlpha: 1,
                            scale: 1.1,
                            duration: 2.5,
                        })
                        .to(
                            {},
                            {
                                duration: 1,
                            },
                        );

                    if (index < cityCards.length - 1) {
                        tl.to(label, {
                            autoAlpha: 0,
                        });
                    }
                    if (index === cityCards.length - 1) {
                        tl.to(".mask-japan", {
                            maskSize: "clamp(10vh, 25%, 25vh)",

                            scale: 1,
                            duration: 5,
                        })
                            .to(
                                "#header-travel",
                                {
                                    autoAlpha: 0,
                                    duration: 0.5,
                                },
                                "<",
                            )
                            .to(
                                "#container-img",
                                {
                                    autoAlpha: 0,
                                    scale: 1,
                                },
                                "-=0.8",
                            )
                            .to(
                                ".mask-japan",
                                {
                                    maskPosition: "50% 100%",
                                    backgroundColor: "rgba(255, 101, 36, 1)",
                                    duration: 2.2,
                                    // background
                                    //
                                },
                                "<",
                            )
                            .to("#header-travel", {
                                autoAlpha: 1,
                                duration: 0.5,
                                backgroundColor: "rgba(255, 101, 36, .8)",
                                onStart: () => setHeaderIconicState(true),
                                onReverseComplete: () =>
                                    setHeaderIconicState(false),

                                // color: "#ff6524",
                            })
                            .to(
                                "#header-pc .buttomPrimary",
                                {
                                    backgroundColor: "#ffffff",
                                    color: "#ff6524",
                                    duration: 0.5,
                                },
                                "<",
                            )
                            .to(
                                ".text-nav-custom",
                                {
                                    color: "#ffffff",
                                    duration: 0.5,
                                },
                                "<",
                            )
                            .to(
                                ".header-logo-default",
                                {
                                    autoAlpha: 0,
                                    duration: 0.5,
                                },
                                "<",
                            )
                            .to(
                                ".header-logo-white",
                                {
                                    autoAlpha: 1,
                                    duration: 0.5,
                                },
                                "<",
                            );

                        // .to("#label-links", {
                        //     color: "#ff6524",
                        // });
                    }

                    tl.to(
                        img,
                        {
                            scale: 1.04,
                            duration: index < cityCards.length - 1 ? 5.5 : 5,
                            ease: "none",
                        },
                        cardStart,
                    );
                });
            },
        );
    }
    // --------------------------

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", animateIconicCities, {
            once: true,
        });
    } else {
        animateIconicCities();
    }
</script>
